{
  "id": "./",
  "name": "NoteDown",
  "short_name": "NoteDown",
  "description": "Markdown notes with widgets, images and math. Works offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fafafa",
  "theme_color": "#fafafa",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/zip": [".notedown", ".notes"],
        "application/octet-stream": [".notedown", ".notes"],
        "application/x-notedown": [".notedown", ".notes"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
